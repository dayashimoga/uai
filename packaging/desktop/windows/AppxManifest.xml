<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap rescap">

  <Identity Name="UniversalAIAssistant"
            Publisher="CN=UniversalAIAssistant"
            Version="1.0.0.0"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Universal AI Assistant</DisplayName>
    <PublisherDisplayName>Universal AI Assistant Open Source Contributors</PublisherDisplayName>
    <Logo>data\flutter_assets\assets\icons\app_icon_150.png</Logo>
    <Description>100% Offline-First Personal AI Assistant with Voice, Local Models, and Cross-Device P2P</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop"
                        MinVersion="10.0.19041.0"
                        MaxVersionTested="10.0.22631.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate" />
  </Resources>

  <Applications>
    <Application Id="AissistantApp"
                 Executable="aissistant.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Universal AI Assistant"
                          Description="100% Offline-First Personal AI Assistant"
                          BackgroundColor="transparent"
                          Square150x150Logo="data\flutter_assets\assets\icons\app_icon_150.png"
                          Square44x44Logo="data\flutter_assets\assets\icons\app_icon_44.png">
        <uap:DefaultTile ShortName="AI Assistant">
          <uap:ShowNameOnTiles>
            <uap:ShowOn Tile="square150x150Logo" />
          </uap:ShowNameOnTiles>
        </uap:DefaultTile>
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Full trust capability for native Rust core and C-ABI execution -->
    <rescap:Capability Name="runFullTrust" />
    <!-- Local microphone access for offline speech and wake-word spotting -->
    <DeviceCapability Name="microphone" />
    <!-- Local network socket capability for mDNS discovery and QUIC mesh sync -->
    <Capability Name="privateNetworkClientServer" />
  </Capabilities>

</Package>
